@startuml
!pragma layout smetana
title Contact App — Java 25 technical class model
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "se.lexicon" {
  class App {
    {static} + main(args : String[]) : void
  }
}
package "se.lexicon.model" {
  class Contact {
    - name : String
    - phoneNumber : String
    + Contact(name : String, phoneNumber : String)
    + getName() : String
    + setName(name : String) : void
    + getPhoneNumber() : String
    + setPhoneNumber(phoneNumber : String) : void
    + toString() : String
    + equals(other : Object) : boolean
    + hashCode() : int
  }
}
package "se.lexicon.data" {
  interface ContactDAO {
    + findAll() : List<Contact>
    + save(contact : Contact) : void
    + findByName(name : String) : Contact
  }
  class FileContactDAOImpl {
    - filePath : Path
    + FileContactDAOImpl(filePath : Path)
    + findAll() : List<Contact>
    + save(contact : Contact) : void
    + findByName(name : String) : Contact
  }
}
package "se.lexicon.view" {
  class ContactView {
    - scanner : Scanner
    - out : PrintStream
    + ContactView(scanner : Scanner, out : PrintStream)
    + displayMenu() : void
    + getUserInput(prompt : String) : String
    + displayContacts(contacts : List<Contact>) : void
    + displayMessage(message : String) : void
    + displayError(message : String) : void
  }
}
package "se.lexicon.controller" {
  class ContactController {
    - contactDAO : ContactDAO
    - contactView : ContactView
    - exceptionHandler : ExceptionHandler
    + ContactController(contactDAO : ContactDAO, contactView : ContactView)
    + run() : void
    - addContact() : boolean
    - searchContact() : boolean
  }
}
package "se.lexicon.exception" {
  class ContactStorageException <<checked exception>> {
    + ContactStorageException(message : String)
    + ContactStorageException(message : String, cause : Throwable)
  }
  class DuplicateContactException <<checked exception>> {
    + DuplicateContactException(message : String)
  }
  class ExceptionHandler {
    - view : ContactView
    + ExceptionHandler(view : ContactView)
    + handle(exception : Exception) : void
  }
}
package "java.lang" {
  class Exception <<JDK>>
  class RuntimeException <<JDK>>
  class IllegalArgumentException <<JDK>>
}
ContactDAO <|.. FileContactDAOImpl : implements
Exception <|-- ContactStorageException
Exception <|-- DuplicateContactException
Exception <|-- RuntimeException
RuntimeException <|-- IllegalArgumentException
App ..> ContactController : starts
App ..> ContactView : constructs
App ..> FileContactDAOImpl : constructs
ContactController --> ContactDAO : invokes
ContactController --> ContactView : controls
ContactController *-- ExceptionHandler : owns
ExceptionHandler --> ContactView : displayError
ContactController ..> Contact : creates
ContactDAO ..> Contact : stores / returns
FileContactDAOImpl ..> ContactStorageException : throws
FileContactDAOImpl ..> DuplicateContactException : throws
Contact ..> IllegalArgumentException : invalid input

note right of ContactDAO
  Checked contracts:
  findAll() throws ContactStorageException
  save() throws ContactStorageException,
         DuplicateContactException
  findByName() throws ContactStorageException
end note
note bottom of FileContactDAOImpl
  Uses UTF-8 BufferedReader / BufferedWriter
  via try-with-resources; TAB-separated records.
end note
@enduml
