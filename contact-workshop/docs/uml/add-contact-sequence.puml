@startuml
title Add Contact — Java 25 exception-aware sequence
skinparam shadowing false
autonumber
actor User
participant ContactView as View
participant ContactController as Ctrl
participant Contact as Model
participant FileContactDAOImpl as DAO
participant "contacts.txt" as File
participant ExceptionHandler as Handler
Ctrl -> View : getUserInput("Name: ")
View -> User : prompt
User --> View : name
View --> Ctrl : name
Ctrl -> View : getUserInput("Phone number (10 digits): ")
View -> User : prompt
User --> View : phoneNumber
View --> Ctrl : phoneNumber
Ctrl -> Model ++ : new Contact(name, phoneNumber)
Model -> Model : setName / setPhoneNumber
alt invalid input
  Model --> Ctrl : throws IllegalArgumentException
  deactivate Model
  Ctrl -> Handler : handle(exception)
  Handler -> View : displayError("Invalid input: ...")
else valid contact
  Model --> Ctrl : contact
  deactivate Model
  Ctrl -> DAO ++ : save(contact)
  DAO -> DAO : findAll() [duplicate / corrupt-file check]
  opt file exists
    DAO -> File : read all lines (try-with-resources)
    File --> DAO : tab-separated records
    DAO -> DAO : parse / validate each Contact
  end
  alt duplicate name
    DAO --> Ctrl : throws DuplicateContactException
    Ctrl -> Handler : handle(exception)
    Handler -> View : displayError("... already exists")
  else invalid persisted record or I/O failure
    DAO --> Ctrl : throws ContactStorageException
    Ctrl -> Handler : handle(exception)
    Handler -> View : displayError("Contact storage problem: ...")
  else valid unique record
    DAO -> File : create / append UTF-8 TAB record
    File --> DAO : append completed
    DAO --> Ctrl : void
    Ctrl -> View : displayMessage("Contact saved successfully.")
  end
  deactivate DAO
end
@enduml
